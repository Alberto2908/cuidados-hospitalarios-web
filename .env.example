# La API sale por NGINX en local (https://localhost/api/...); ver deploy/ en el repo del server
NEXT_PUBLIC_API_URL=https://localhost
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Clave PUBLICABLE de Stripe (pk_test_... en pruebas). Es publica; la clave
# secreta (sk_...) va solo en el .env del server.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Tiles del mapa (CARTO Voyager/Positron): gratis en https://carto.com/basemaps
# Sin esta key, lib/map/tileStyles.ts usa IGN Base como alternativa.
NEXT_PUBLIC_CARTO_API_KEY=

# Mismo valor que JWT_SECRET en el .env del server (verificacion en middleware.ts)
JWT_SECRET=
