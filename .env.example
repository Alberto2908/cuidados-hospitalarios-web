NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Tiles del mapa (CARTO Voyager/Positron): gratis en https://carto.com/basemaps
# Sin esta key, lib/map/tileStyles.ts usa IGN Base como alternativa.
NEXT_PUBLIC_CARTO_API_KEY=

# Mismo valor que JWT_SECRET en el .env del server (verificacion en middleware.ts)
JWT_SECRET=
